{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradix.example/standards/ecoscan/0.1/source-descriptor.schema.json",
  "title": "ECOSCAN Source Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "owner_id",
    "operator_id",
    "subsystem_id",
    "source_type",
    "locator",
    "adapter_id",
    "adapter_version",
    "credential_ref",
    "enabled",
    "scope_tags",
    "budget",
    "expected_measurements",
    "retention_policy",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "operator_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "subsystem_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_type": {
      "const": "filesystem"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "adapter_id": {
      "const": "filesystem"
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "credential_ref": {
      "type": "null"
    },
    "enabled": {
      "type": "boolean"
    },
    "scope_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_pages",
        "max_items",
        "timeout_seconds",
        "max_duration_seconds"
      ],
      "properties": {
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "expected_measurements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "logical_bytes",
          "allocated_bytes",
          "physical_bytes",
          "capacity_bytes",
          "object_count",
          "file_count",
          "provider_reported_usage"
        ]
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_days",
        "evidence_days"
      ],
      "properties": {
        "history_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36500
        },
        "evidence_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36500
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
