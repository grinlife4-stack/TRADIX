{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridex:bridge-manifest:0.1",
  "title": "BRIDEX Independent Bridge Manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "bridge_id",
    "version",
    "owner",
    "operator",
    "obis",
    "runtime",
    "capabilities",
    "package_files"
  ],
  "properties": {
    "manifest_version": {
      "const": "0.1"
    },
    "bridge_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "owner": {
      "$ref": "#/$defs/party"
    },
    "operator": {
      "$ref": "#/$defs/party"
    },
    "maintainer": {
      "$ref": "#/$defs/party"
    },
    "obis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "transport_binding",
        "security_profile"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "transport_binding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "security_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "independent"
      ],
      "properties": {
        "kind": {
          "enum": [
            "python",
            "node",
            "binary",
            "container",
            "other"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "independent": {
          "const": true
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "package_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "license_id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "license_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "version",
        "scopes",
        "side_effect",
        "idempotent",
        "timeout_seconds",
        "max_payload_bytes",
        "input_schema_uri",
        "output_schema_uri"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^(https://|urn:)[^\\s]+$",
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)+$",
            "maxLength": 128
          }
        },
        "side_effect": {
          "enum": [
            "read-only",
            "state-changing",
            "financial-or-irreversible",
            "other"
          ]
        },
        "idempotent": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "input_schema_uri": {
          "type": "string",
          "format": "uri"
        },
        "output_schema_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
