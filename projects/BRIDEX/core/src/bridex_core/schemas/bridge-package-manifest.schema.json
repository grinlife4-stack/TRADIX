{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridex:schemas:bridge-package-manifest:0.1",
  "title": "BRIDEX Bridge Package Manifest 0.1",
  "description": "Draft, owner-exportable metadata contract for an independently deployable Bridge package. This does not define OBIS wire semantics or approve a security profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "bridge",
    "ownership",
    "source",
    "contracts",
    "peers",
    "capabilities",
    "configuration_schema",
    "dependencies",
    "lifecycle"
  ],
  "properties": {
    "manifest_version": {
      "const": "0.1"
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "implementation_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "implementation_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "operator",
        "assignment_record"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/party"
        },
        "operator": {
          "$ref": "#/$defs/party"
        },
        "maintainer": {
          "$ref": "#/$defs/party"
        },
        "assignment_record": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_uri",
        "sha256"
      ],
      "properties": {
        "package_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obis_versions",
        "adapters"
      ],
      "properties": {
        "obis_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/versioned_contract"
          }
        }
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "peer_id",
          "approved_scopes"
        ],
        "properties": {
          "peer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "approved_scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "direction",
          "scopes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "direction": {
            "enum": [
              "provides",
              "consumes"
            ]
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "configuration_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "license"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "deploy",
        "backup",
        "restore",
        "upgrade",
        "rollback",
        "revocation",
        "export",
        "decommission"
      ],
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "deploy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "backup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "restore": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "upgrade": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "rollback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "revocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "export": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "decommission": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "versioned_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
