{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:obis:conformance:message-schema-suite:0.1",
  "title": "OBIS 0.1 Message Schema Conformance Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_version",
    "protocol",
    "protocol_version",
    "validation_layer",
    "schema",
    "vectors"
  ],
  "properties": {
    "suite_version": {
      "const": "0.1"
    },
    "protocol": {
      "const": "obis"
    },
    "protocol_version": {
      "const": "0.1"
    },
    "validation_layer": {
      "const": "message-schema"
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "expected",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "accept",
              "reject"
            ]
          },
          "message": {
            "type": "object"
          }
        }
      }
    }
  }
}
