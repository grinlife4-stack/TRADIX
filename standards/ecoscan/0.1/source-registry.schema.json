{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradix.example/standards/ecoscan/0.1/source-registry.schema.json",
  "title": "ECOSCAN 0.1 Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_id", "owner_id", "operator_id", "source_type", "locator", "adapter_id", "adapter_version", "credential_ref", "enabled", "budget", "expected_measurements", "retention_policy", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_id": {"$ref": "#/$defs/identifier"},
    "owner_id": {"$ref": "#/$defs/identifier"},
    "operator_id": {"$ref": "#/$defs/identifier"},
    "source_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "locator": {"type": "string", "minLength": 1, "maxLength": 2048},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "credential_ref": {"type": ["string", "null"], "maxLength": 512},
    "enabled": {"type": "boolean"},
    "scope_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 64}, "default": []},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_pages", "max_items", "timeout_seconds", "max_duration_seconds"],
      "properties": {
        "max_pages": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_items": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "expected_measurements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["logical_bytes", "allocated_bytes", "physical_bytes", "capacity_bytes", "object_count", "file_count", "provider_reported_usage"]}},
    "retention_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["history_days", "evidence_days"],
      "properties": {
        "history_days": {"type": "integer", "minimum": 0, "maximum": 36500},
        "evidence_days": {"type": "integer", "minimum": 0, "maximum": 36500}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"}
  }
}