{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradix.example/standards/ecoscan/0.1/measurement.schema.json",
  "title": "ECOSCAN 0.1 Measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "measurement_id", "project_id", "source_id", "kind", "value", "unit", "measured_at", "source_timestamp", "method", "adapter_id", "adapter_version", "coverage_state", "confidence", "limitations", "evidence_ref", "checkpoint_ref"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "measurement_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"enum": ["logical_bytes", "allocated_bytes", "physical_bytes", "capacity_bytes", "object_count", "file_count", "provider_reported_usage"]},
    "value": {"type": "number", "minimum": 0},
    "unit": {"enum": ["byte", "object", "file", "provider_unit"]},
    "measured_at": {"type": "string", "format": "date-time"},
    "source_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "method": {"type": "string", "minLength": 1, "maxLength": 256},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "coverage_state": {"enum": ["COMPLETE", "PARTIAL"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "limitations": {"type": "array", "items": {"type": "string", "maxLength": 2048}, "maxItems": 100},
    "evidence_ref": {"type": ["string", "null"], "maxLength": 1024},
    "checkpoint_ref": {"type": ["string", "null"], "maxLength": 1024}
  }
}