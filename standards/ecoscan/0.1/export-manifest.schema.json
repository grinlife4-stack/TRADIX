{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradix.example/standards/ecoscan/0.1/export-manifest.schema.json",
  "title": "ECOSCAN 0.1 Export Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "project_id",
    "exported_at",
    "included_from",
    "included_through",
    "files",
    "credential_policy",
    "source_system"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "export_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "included_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "included_through": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "credential_policy": {
      "const": "secret-values-excluded;credential-references-redacted"
    },
    "source_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
