{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradix.invalid/schemas/product-portability-v1.schema.json",
  "title": "TRADIX Product Portability Manifest v1",
  "description": "Machine-readable portability contract. Design completeness is distinct from release readiness; release requires verified evidence and a successful restore on a second isolated target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_key",
    "product_type",
    "status",
    "source",
    "runtime",
    "dependencies",
    "data_assets",
    "artifacts",
    "secrets",
    "backup_restore",
    "exit_cost"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "product_type": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "enum": ["planned", "partial", "verified"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "format", "export_procedure", "import_procedure"],
      "properties": {
        "status": { "enum": ["planned", "partial", "verified"] },
        "format": { "type": "string", "minLength": 1 },
        "export_procedure": { "type": "string", "minLength": 1 },
        "import_procedure": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "interface", "version_policy", "target_matrix", "build_definition"],
      "properties": {
        "status": { "enum": ["planned", "partial", "verified"] },
        "interface": { "type": "string", "minLength": 1 },
        "version_policy": { "type": "string", "minLength": 1 },
        "target_matrix": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "build_definition": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "provider_specific", "adapter", "replacement_plan", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "provider_specific": { "type": "boolean" },
          "adapter": { "type": "string", "minLength": 1 },
          "replacement_plan": { "type": "string", "minLength": 1 },
          "alternatives": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "enum": ["planned", "partial", "verified"] },
          "evidence_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "data_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "format", "export_procedure", "import_procedure", "integrity_method", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 },
          "export_procedure": { "type": "string", "minLength": 1 },
          "import_procedure": { "type": "string", "minLength": 1 },
          "integrity_method": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "partial", "verified"] },
          "evidence_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "interface", "export_procedure", "import_procedure", "integrity_method"],
      "properties": {
        "status": { "enum": ["planned", "partial", "verified"] },
        "interface": { "type": "string", "minLength": 1 },
        "export_procedure": { "type": "string", "minLength": 1 },
        "import_procedure": { "type": "string", "minLength": 1 },
        "integrity_method": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_control_excluded", "export_excluded", "rebind_procedure"],
      "properties": {
        "status": { "enum": ["planned", "partial", "verified"] },
        "source_control_excluded": { "type": "boolean" },
        "export_excluded": { "type": "boolean" },
        "rebind_procedure": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "backup_restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "backup_format", "restore_procedure", "restore_test"],
      "properties": {
        "status": { "enum": ["planned", "partial", "verified"] },
        "backup_format": { "type": "string", "minLength": 1 },
        "restore_procedure": { "type": "string", "minLength": 1 },
        "restore_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["not_run", "passed", "failed"] },
            "target": { "type": ["string", "null"] },
            "tested_at": { "type": ["string", "null"], "format": "date-time" },
            "evidence_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "exit_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currency", "estimated_amount", "estimated_hours", "notes"],
      "properties": {
        "status": { "enum": ["unknown", "estimated", "verified"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "estimated_amount": { "type": ["number", "null"], "minimum": 0 },
        "estimated_hours": { "type": ["number", "null"], "minimum": 0 },
        "notes": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
