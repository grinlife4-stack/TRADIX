{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/checkpoint.schema.json",
  "title": "SessionCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "project_id",
    "created_at",
    "source_versions",
    "verified_state",
    "unknowns"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "verified_state": {
      "type": "object"
    },
    "active_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": [
        "object",
        "null"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
