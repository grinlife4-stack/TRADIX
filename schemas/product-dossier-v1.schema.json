{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradix.invalid/schemas/product-dossier-v1.schema.json",
  "title": "TRADIX Product Dossier v1",
  "description": "Common, product-agnostic envelope for one independently versioned TRADIX product dossier. Domain-specific fields remain extensible.",
  "type": "object",
  "required": [
    "schema_version",
    "product_type",
    "mission",
    "requirements",
    "acceptance_criteria",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "target_date": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": true
    },
    "owner": {
      "type": [
        "string",
        "object"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resource_plan": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "portability": {
      "type": "object",
      "required": ["manifest", "status"],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["planned", "partial", "verified"]
        }
      },
      "additionalProperties": false
    },
    "data_boundaries": {
      "type": "object"
    },
    "security": {
      "type": "object"
    },
    "domain_specification": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
