{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/project-state.schema.json",
  "title": "ProjectState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "status",
    "version",
    "updated_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "ACTIVE",
        "BLOCKED",
        "PAUSED",
        "COMPLETED",
        "ARCHIVED"
      ]
    },
    "mission_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "current_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": [
        "object",
        "null"
      ]
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
